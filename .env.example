# Every environment variable this app reads. Copy to .env.local for local work,
# or pull the real values with: vercel env pull .env.local
#
# Source of truth is Vercel: https://vercel.com/ismail-mbabalis-projects/modern-charm/settings/environment-variables
# Declared in code at src/lib/env.ts

# --- Required -----------------------------------------------------------------
# Resend API key. Without it the contact form and newsletter both return 500.
RESEND_API_KEY=

# --- Optional -----------------------------------------------------------------
# Resend audience for newsletter subscribers. Signups still send a welcome
# email without it; they just are not added to the list.
RESEND_AUDIENCE_ID=

# Sentry DSN. Sentry stays disabled when this is unset.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source map upload at build time. All three are needed together;
# uploads are skipped when SENTRY_AUTH_TOKEN is absent.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
